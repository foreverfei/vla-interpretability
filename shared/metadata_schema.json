{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLA Episode Metadata",
  "type": "object",
  "required": [
    "episode_id",
    "paired_group_id",
    "group",
    "model",
    "checkpoint",
    "model_code_commit",
    "suite",
    "task_id",
    "task_name",
    "initial_state_index",
    "random_seed",
    "condition",
    "instruction",
    "success",
    "episode_length",
    "policy_query_count",
    "config_path",
    "config_hash",
    "git_commit"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "paired_group_id": {"type": "string", "minLength": 1},
    "group": {"enum": ["groupA", "groupB", "integration"]},
    "model": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "model_code_commit": {"type": "string", "minLength": 1},
    "suite": {"const": "libero_object"},
    "task_id": {"type": "integer", "minimum": 0},
    "task_name": {"type": "string", "minLength": 1},
    "initial_state_index": {"type": "integer", "minimum": 0},
    "random_seed": {"type": "integer", "minimum": 0},
    "condition": {
      "enum": ["baseline", "target_mask", "background_control"]
    },
    "instruction": {"type": "string", "minLength": 1},
    "target_object": {"type": "string"},
    "destination_object": {"type": "string"},
    "success": {"type": "boolean"},
    "episode_length": {"type": "integer", "minimum": 0},
    "policy_query_count": {"type": "integer", "minimum": 0},
    "num_open_loop_steps": {"type": "integer", "minimum": 1},
    "config_path": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "minLength": 1},
    "environment_version": {"type": "string"},
    "trace_complete": {"type": "boolean"},
    "trace_step_count": {"type": "integer", "minimum": 0},
    "trace_layers": {
      "type": "array",
      "items": {"type": ["string", "integer"]}
    },
    "action_chunk_shape": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "token_pooling": {"type": "string"},
    "mask_type": {"enum": ["none", "target", "background_control"]},
    "mask_source": {"type": "string"},
    "mask_area_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "replacement_mode": {"type": "string"},
    "paired_baseline_episode": {"type": "string"},
    "failure_stage": {
      "enum": [
        "none",
        "perception_or_approach",
        "grasp",
        "transport",
        "place",
        "timeout",
        "unknown"
      ]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
